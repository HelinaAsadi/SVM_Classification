     "output_type": "display_data"
    }
   ],
   "source": [
    "X, y = make_circles(n_samples=1000, noise=0.15, factor=0.3, random_state=0)\n",
    "\n",
    "fig, ax = plt.subplots()\n",
    "ax.scatter(X[:, 0] , X[:, 1], c=y)\n",
    "ax.set_title(\"synthetic data\")\n",
    "plt.show()"
   ],
